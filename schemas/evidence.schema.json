{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andra884/reimagined-memory/blob/master/schemas/evidence.schema.json",
  "title": "Evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_kind",
    "locator",
    "supports",
    "captured_at",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "regulation",
        "policy",
        "standard",
        "system_of_record",
        "document",
        "user_statement",
        "observation",
        "illustrative"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_published_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "verification": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "disputed"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
