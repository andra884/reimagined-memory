{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andra884/reimagined-memory/blob/master/schemas/memory.schema.json",
  "title": "Memory record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "statement",
    "status",
    "scope",
    "created_at",
    "evidence_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "fact",
        "preference",
        "decision",
        "instruction",
        "definition",
        "rule",
        "inference",
        "open_question"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "asserted",
        "tentative",
        "disputed",
        "superseded",
        "expired"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applies_to": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "authority_id": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
